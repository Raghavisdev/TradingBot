# ====================================================
# TRADING BOT PRODUCTION CONFIGURATION (.env.example)
# Rename this file to .env and fill in your values.
# ====================================================

# ----------------------------------------------------
# TELEGRAM CREDENTIALS (Required)
# Get from https://my.telegram.org
# ----------------------------------------------------
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_SESSION=TradingBot

# ----------------------------------------------------
# DATABASE SETTINGS
# ----------------------------------------------------
DATABASE_PATH=database/trading.db

# ----------------------------------------------------
# TRACKER & API SETTINGS
# ----------------------------------------------------
SNAPSHOT_INTERVAL=5
TRACKING_DURATION=86400
MAX_API_FAILURES=20
DEXSCREENER_TIMEOUT=10

# ----------------------------------------------------
# TRADING & AI THRESHOLDS
# ----------------------------------------------------
BUY_THRESHOLD=70.0
INVESTMENT_PER_TRADE=3.0
MAX_OPEN_POSITIONS=10
PAPER_TRADING=True

# ----------------------------------------------------
# LOGGING & MONITORING
# ----------------------------------------------------
LOG_LEVEL=INFO
HEALTH_LOG_INTERVAL=600
