# ====================================================
# TRADING BOT PRODUCTION CONFIGURATION (.env.example)
# Rename this file to .env and fill in your values.
# ====================================================

# ----------------------------------------------------
# TELEGRAM CREDENTIALS (Required)
# Get from https://my.telegram.org
# ----------------------------------------------------
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_SESSION=TradingBot

# ----------------------------------------------------
# DATABASE SETTINGS
# ----------------------------------------------------
DATABASE_PATH=database/trading.db

# ----------------------------------------------------
# TRACKER & API SETTINGS
# ----------------------------------------------------
SNAPSHOT_INTERVAL=5
TRACKING_DURATION=86400
MAX_API_FAILURES=20
DEXSCREENER_TIMEOUT=10

# ----------------------------------------------------
# TRADING & AI THRESHOLDS
# ----------------------------------------------------
BUY_THRESHOLD=70.0
INVESTMENT_PER_TRADE=3.0
MAX_OPEN_POSITIONS=10
PAPER_TRADING=True

# ----------------------------------------------------
# LOGGING & MONITORING
# ----------------------------------------------------
LOG_LEVEL=INFO
HEALTH_LOG_INTERVAL=600

# ====================================================
# INTELLIGENCE LAYER v2 (AI V2 — Passive Collection)
# All settings below are OPTIONAL.
# The bot runs fully without them.
# ====================================================

# ----------------------------------------------------
# TWITTER / X API (Optional)
# Get from https://developer.twitter.com
# Free tier: 500k tweet reads/month — enough for this bot.
# Leave blank to use free-tier fallbacks (DuckDuckGo, RSS).
# When set, auto-enables Social + KOL collection.
# ----------------------------------------------------
TWITTER_BEARER_TOKEN=

# ----------------------------------------------------
# INTELLIGENCE COLLECTION SCHEDULE
# Controls how many time-series snapshots are collected.
# Default: 9 snapshots (0,5,15,30,60,120,360,720,1440 min)
# Do NOT change unless you understand the impact on DB size.
# ----------------------------------------------------
INTEL_MAX_COLLECTION_INDEX=8

# ----------------------------------------------------
# DECISION ENGINE V2 (Future — NOT active yet)
# Set to True ONLY after training a model on collected data.
# Shadow mode: V2 logs recommendations but does NOT trade.
# Live mode: V2 fully replaces V1 decision after validation.
# ----------------------------------------------------
DECISION_V2_ACTIVE=False
